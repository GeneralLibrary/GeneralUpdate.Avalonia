<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeneralUpdate.Avalonia.Android.Sample.Views.MainView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="GeneralUpdate 移动端自动升级"
                 FontSize="24"
                 FontWeight="Bold" />
      <TextBlock Text="连接 GeneralSpacestation，完成版本校验、APK 下载、SHA-256 校验和安装。"
                 TextWrapping="Wrap"
                 Opacity="0.75" />

      <Border Padding="14"
              CornerRadius="8"
              Background="#14007ACC">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本：" />
          <TextBlock x:Name="CurrentVersionText"
                     Grid.Row="0"
                     Grid.Column="1"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="目标版本：" />
          <TextBlock x:Name="TargetVersionText"
                     Grid.Row="1"
                     Grid.Column="1"
                     Text="尚未检查" />
        </Grid>
      </Border>

      <TextBlock Text="GeneralSpacestation 配置"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0" />

      <TextBlock Text="验证接口" />
      <TextBox x:Name="RequestUrlTextBox"
               Text="http://127.0.0.1:5080/Upgrade/Verification"
               PlaceholderText="https://server/Upgrade/Verification" />

      <TextBlock Text="AppKey" />
      <TextBox x:Name="AppKeyTextBox"
               Text="demo-client"
               PlaceholderText="管理端配置的 AppKey" />

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Platform" />
          <TextBox x:Name="PlatformTextBox"
                   Text="3"
                   PlaceholderText="Android 平台编号" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="ProductId" />
          <TextBox x:Name="ProductIdTextBox"
                   Text="demo-product"
                   PlaceholderText="产品编号" />
        </StackPanel>
      </Grid>

      <TextBlock Text="更新说明"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0" />
      <TextBlock x:Name="ReleaseNotesText"
                 Text="检查到新版本后显示"
                 TextWrapping="Wrap"
                 MinHeight="44" />

      <ProgressBar x:Name="DownloadProgressBar"
                   Minimum="0"
                   Maximum="100"
                   Value="0"
                   Height="8" />
      <TextBlock x:Name="ProgressText"
                 Text="0%"
                 HorizontalAlignment="Right" />

      <Border Padding="12"
              CornerRadius="8"
              Background="#12000000">
        <TextBlock x:Name="StatusText"
                   Text="等待检查更新"
                   TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="12"
            Margin="0,8,0,20">
        <Button x:Name="StartButton"
                Grid.Column="0"
                Content="检查并自动升级"
                HorizontalAlignment="Stretch"
                Click="OnStartUpdate" />
        <Button x:Name="CancelButton"
                Grid.Column="1"
                Content="取消"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Click="OnCancelUpdate" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
