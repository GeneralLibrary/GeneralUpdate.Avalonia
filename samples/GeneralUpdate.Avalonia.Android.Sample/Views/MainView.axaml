<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeneralUpdate.Avalonia.Android.Sample.ViewModels"
             x:DataType="vm:UpdateViewModel"
             x:CompileBindings="True"
             x:Class="GeneralUpdate.Avalonia.Android.Sample.Views.MainView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding LanguageLabel}" />
          <ComboBox SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeLanguage}">
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="中文" />
          </ComboBox>
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding Description}"
                 TextWrapping="Wrap"
                 Opacity="0.75" />

      <Border Padding="14"
              CornerRadius="8"
              Background="#14007ACC">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CurrentVersionLabel}" />
          <TextBlock x:Name="CurrentVersionText"
                     Text="{Binding CurrentVersion}"
                     Grid.Row="0"
                     Grid.Column="1"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TargetVersionLabel}" />
          <TextBlock x:Name="TargetVersionText"
                     Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding TargetVersion}" />
        </Grid>
      </Border>

      <TextBlock x:Name="InstallationStatusText"
                 Text="{Binding InstallationStatus}"
                 TextWrapping="Wrap" />

      <TextBlock Text="{Binding SettingsTitle}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0" />

      <TextBlock Text="{Binding VerificationEndpointLabel}" />
      <TextBox x:Name="RequestUrlTextBox"
               Text="{Binding RequestUrl, Mode=TwoWay}"
               PlaceholderText="https://server/Upgrade/Verification" />

      <TextBlock Text="AppKey" />
      <TextBox x:Name="AppKeyTextBox"
               Text="{Binding AppKey, Mode=TwoWay}"
               PlaceholderText="{Binding AppKeyPlaceholder}" />

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Platform" />
          <TextBox x:Name="PlatformTextBox"
                   Text="{Binding Platform, Mode=TwoWay}"
                   PlaceholderText="{Binding PlatformPlaceholder}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="ProductId" />
          <TextBox x:Name="ProductIdTextBox"
                   Text="{Binding ProductId, Mode=TwoWay}"
                   PlaceholderText="{Binding ProductIdPlaceholder}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding ReleaseNotesLabel}"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0" />
      <TextBlock x:Name="ReleaseNotesText"
                 Text="{Binding ReleaseNotes}"
                 TextWrapping="Wrap"
                 MinHeight="44" />

      <ProgressBar x:Name="DownloadProgressBar"
                   Minimum="0"
                   Maximum="100"
                   Value="{Binding Progress}"
                   Height="8" />
      <TextBlock x:Name="ProgressText"
                 Text="{Binding ProgressText}"
                 HorizontalAlignment="Right" />

      <Border Padding="12"
              CornerRadius="8"
              Background="#12000000">
        <TextBlock x:Name="StatusText"
                   Text="{Binding Status}"
                   TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="12"
            Margin="0,8,0,20">
        <Button x:Name="StartButton"
                Grid.Column="0"
                Content="{Binding StartButtonText}"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding CanStart}"
                Click="OnStartUpdate" />
        <Button x:Name="CancelButton"
                Grid.Column="1"
                Content="{Binding CancelButtonText}"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding CanCancel}"
                Click="OnCancelUpdate" />
      </Grid>
      <Button Content="{Binding ResetButtonText}"
              IsEnabled="{Binding CanStart}"
              Click="OnResetInstallation" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
